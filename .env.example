# Copie este arquivo para .env e ajuste os valores.
# Nunca envie o arquivo .env para o GitHub.

# Aplicação
APP_NAME=Otica Support API
APP_ENV=development
DEBUG=true

# Banco de dados (PostgreSQL)
DATABASE_URL=postgresql+psycopg://otica:otica@localhost:5432/otica_support

# Segurança / autenticação (JWT)
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (endereços do front e do painel do dono, separados por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Pagamentos (Pix/cartão) - preencher quando o provedor for definido
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
